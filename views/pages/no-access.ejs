<section class="section">
  <div class="container container-narrow text-center">
    <p class="kicker justify-content-center">403</p>
    <h1><%= t('auth.noAccessTitle') %></h1>
    <p class="lead-text"><%= t('auth.noAccessText') %></p>
    <form method="post" action="/auth/logout" class="mt-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-outline-dark" type="submit"><%= t('auth.logout') %></button>
    </form>
  </div>
</section>
