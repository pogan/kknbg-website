<%- include('../partials/page-hero', {
  heading: t('sport.title'), kicker: t('nav.sport'), lead: t('sport.lead'),
  crumbs: [{ name: t('nav.sport'), path: '/sport' }]
}) %>

<section class="section section--tight">
  <div class="container">
    <div class="split">
      <div class="split__media"><img src="/img/sportowe.jpg" alt="Deska kibica na mecz" width="640" height="480" loading="lazy"></div>
      <div><%- include('../partials/editable', { block: sport_lead, tag: 'div', label: 'Sport — wstęp' }) %>
        <a class="btn btn-primary mt-3" href="<%= localePath('/kontakt') %>#rezerwacja"><%= t('nav.reserve') %></a>
      </div>
    </div>
  </div>
</section>

<% if (fixtures && fixtures.length) { %>
<section class="section section--sunk">
  <div class="container container-narrow">
    <h2 style="font-size:var(--step-2)">Najbliższe transmisje</h2>
    <p class="tiny muted">Terminarz poglądowy — w wersji produkcyjnej zasilany z panelu / API transmisji.</p>
    <div class="mt-3">
      <% fixtures.forEach(function(f){ %>
        <div class="event-card">
          <div class="event-card__date">
            <div class="event-card__day"><%= formatDate(f.when, 'D') %></div>
            <div class="event-card__mon"><%= formatDate(f.when, 'MMM') %></div>
          </div>
          <div>
            <span class="tag"><%= f.league %></span>
            <p class="m-0 mt-1"><strong><%= f.match %></strong></p>
            <span class="tiny muted"><%= formatDate(f.when, 'dddd, HH:mm') %></span>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
