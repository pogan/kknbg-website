<%
  const dayNames = { mon:'Poniedziałek', tue:'Wtorek', wed:'Środa', thu:'Czwartek', fri:'Piątek', sat:'Sobota', sun:'Niedziela' };
  const dayNamesEn = { mon:'Monday', tue:'Tuesday', wed:'Wednesday', thu:'Thursday', fri:'Friday', sat:'Saturday', sun:'Sunday' };
  const dn = locale === 'en' ? dayNamesEn : dayNames;
  const hours = settings.openingHours;
%>
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="site-logo mb-3" href="<%= localePath('/') %>" style="color:#fff">
          <%- include('./logo-mark') %>
          <span style="color:#fff">Nowy Browar<br>Gdański</span>
        </a>
        <p class="tiny" style="color:#b7afa1"><%= locale === 'en' ? site.tagline.en : site.tagline.pl %></p>
        <div class="footer-social mt-3">
          <a href="<%= settings.social.instagram %>" aria-label="Instagram" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>
          </a>
          <a href="<%= settings.social.facebook %>" aria-label="Facebook" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3l.5-3H14V4.5c0-.8.3-1.5 1.5-1.5H17V.2C16.6.1 15.5 0 14.3 0 11.7 0 10 1.6 10 4.3V6H7v3h3v9h4V9Z"/></svg>
          </a>
          <a href="<%= settings.social.tiktok %>" aria-label="TikTok" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 2c.3 2.3 1.9 4.2 4 4.6v3c-1.5 0-2.9-.4-4-1.1V15a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v3.1a3 3 0 1 0 2 2.8V2h3Z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h3><%= t('footer.hoursTitle') %></h3>
        <ul class="footer-hours">
          <% ['mon','tue','wed','thu','fri','sat','sun'].forEach(function(d){ %>
            <li><span><%= dn[d] %></span><span><% (hours[d]||[]).forEach(function(r,i){ %><%= (i?', ':'') + r[0] + '–' + r[1] %><% }); %></span></li>
          <% }); %>
        </ul>
        <p class="tiny mt-2" style="color:#b7afa1"><%= locale === 'en' ? settings.serviceNotes.en : settings.serviceNotes.pl %></p>
      </div>

      <div>
        <h3><%= t('footer.findUs') %></h3>
        <p>
          <%= settings.address.street %><br>
          <%= settings.address.postal %> <%= settings.address.city %><br>
          <span class="tiny" style="color:#b7afa1"><%= settings.address.district %></span>
        </p>
        <p>
          <a href="tel:<%= settings.contact.phone.replace(/\s/g,'') %>"><%= settings.contact.phone %></a><br>
          <a href="mailto:<%= settings.contact.email %>"><%= settings.contact.email %></a>
        </p>
        <a class="link-arrow" style="color:#fff" href="<%= localePath('/lokalizacja') %>"><%= t('cta.getDirections') %> →</a>
      </div>

      <div>
        <h3><%= t('footer.newsletterTitle') %></h3>
        <p class="tiny" style="color:#b7afa1"><%= t('footer.newsletterText') %></p>
        <form method="post" action="<%= localePath('/formularz/newsletter') %>" class="mt-2" data-ajax-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="text" name="company_website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="source" value="footer">
          <div class="d-flex gap-2">
            <label class="visually-hidden" for="nl-email"><%= t('contact.email') %></label>
            <input class="form-control" id="nl-email" type="email" name="email" placeholder="<%= t('contact.email') %>" required>
            <button class="btn btn-primary" type="submit"><%= t('footer.newsletterCta') %></button>
          </div>
          <p class="form-message tiny mt-2" role="status"></p>
        </form>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© <%= year %> <%= settings.name %>. <%= t('footer.rights') %></span>
      <nav class="d-flex flex-wrap gap-3">
        <a href="<%= localePath('/polityka-prywatnosci') %>"><%= t('footer.privacy') %></a>
        <a href="<%= localePath('/regulamin') %>"><%= t('footer.terms') %></a>
        <a href="<%= localePath('/regulamin-sklepu') %>"><%= t('footer.shopTerms') %></a>
        <button type="button" class="btn btn-link p-0 border-0" style="color:#9a9285;font-size:.82rem" data-cookie-open><%= t('footer.cookies') %></button>
      </nav>
    </div>
  </div>
</footer>
