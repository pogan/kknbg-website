<section class="section">
  <div class="container container-narrow text-center">
    <p class="kicker justify-content-center"><%= t('shop.paid') %> ✓</p>
    <h1><%= t('shop.thankYouTitle') %></h1>
    <p class="lead-text"><%= t('shop.thankYouText') %></p>
    <p class="muted"><%= t('shop.orderNumber') %>: <strong><%= order.number %></strong></p>

    <div class="form-card text-start mt-4">
      <% order.items.forEach(function(it){ %>
        <div class="d-flex justify-content-between py-1"><span><%= it.qty %>× <%= it.name_snapshot %></span><span><%= formatPrice(it.unit_price_grosze * it.qty) %></span></div>
      <% }); %>
      <hr>
      <div class="d-flex justify-content-between"><span><%= t('shop.shipping') %> (<%= order.fulfillment === 'courier' ? 'kurier' : 'odbiór w lokalu' %>)</span><span><%= formatPrice(order.shipping_grosze) %></span></div>
      <div class="d-flex justify-content-between" style="font-size:var(--step-1)"><strong><%= t('shop.total') %></strong><strong><%= formatPrice(order.total_grosze) %></strong></div>
    </div>

    <a class="btn btn-primary mt-4" href="<%= localePath('/sklep') %>"><%= t('shop.continueShopping') %></a>
    <p class="tiny muted mt-4">Potwierdzenie trafiło do skrzynki e-mail (w prototypie: <code>data/outbox/</code> i panel → Skrzynka).</p>
  </div>
</section>
