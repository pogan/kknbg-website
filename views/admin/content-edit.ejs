<div class="admin-card">
  <form method="post" action="/admin/tresc/<%= key %>/<%= locale %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <div>
        <code><%= key %></code> · język: <strong><%= locale.toUpperCase() %></strong>
      </div>
      <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-dark" href="/admin/tresc/<%= key %>/<%= locale === 'pl' ? 'en' : 'pl' %>">Przełącz na <%= locale === 'pl' ? 'EN' : 'PL' %></a>
        <a class="btn btn-sm btn-outline-dark" href="/admin/tresc">← Lista</a>
      </div>
    </div>

    <label class="form-label" for="title">Tytuł</label>
    <input class="form-control mb-3" id="title" name="title" value="<%= block.title || '' %>">

    <label class="form-label" for="body">Treść (HTML — dozwolone: nagłówki, akapity, listy, linki, pogrubienie)</label>
    <div class="row g-3">
      <div class="col-lg-6">
        <textarea class="form-control" id="body" name="body_html" rows="18" data-live-preview="#preview" style="font-family:ui-monospace,monospace;font-size:.85rem"><%= block.body_html || '' %></textarea>
      </div>
      <div class="col-lg-6">
        <div class="tiny muted mb-1">Podgląd</div>
        <div id="preview" class="rich" style="border:1px solid var(--line);border-radius:12px;padding:1rem;min-height:12rem;background:#fff"><%- block.body_html || '' %></div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <button class="btn btn-primary" type="submit">Zapisz i opublikuj</button>
      <a class="btn btn-outline-dark" href="/" target="_blank">Zobacz stronę</a>
    </div>
  </form>
</div>

<script>
  (function(){
    var ta = document.getElementById('body');
    var prev = document.getElementById('preview');
    if (ta && prev) ta.addEventListener('input', function(){ prev.innerHTML = ta.value; });
  })();
</script>
