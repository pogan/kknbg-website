<div class="admin-card">
  <div class="d-flex flex-wrap gap-2">
    <a class="pill <%= !activeType ? 'pill--new' : 'pill--draft' %>" href="/admin/zapytania">Wszystkie</a>
    <% ['contact','reservation','event','b2b','newsletter'].forEach(function(tp){ %>
      <a class="pill <%= activeType === tp ? 'pill--new' : 'pill--draft' %>" href="/admin/zapytania?type=<%= tp %>">
        <%= tp %><%= counts[tp] ? ' (' + counts[tp] + ')' : '' %>
      </a>
    <% }); %>
  </div>
</div>

<div class="admin-card">
  <table class="admin-table">
    <thead><tr><th>Typ</th><th>Od</th><th>Treść / szczegóły</th><th>Status</th><th>Data</th><th></th></tr></thead>
    <tbody>
      <% inquiries.forEach(function(i){ let meta = {}; try { meta = JSON.parse(i.meta_json||'{}'); } catch(e){} %>
        <tr>
          <td><span class="pill pill--new"><%= i.type %></span></td>
          <td>
            <strong><%= i.name || '—' %></strong><br>
            <span class="tiny"><% if (i.email) { %><a href="mailto:<%= i.email %>"><%= i.email %></a><% } %> <%= i.phone %></span>
          </td>
          <td class="tiny">
            <%= i.message %>
            <% Object.keys(meta).forEach(function(k){ %><br><span class="muted"><%= k %>:</span> <%= meta[k] %><% }); %>
          </td>
          <td>
            <span class="pill <%= i.status === 'new' ? 'pill--new' : 'pill--archived' %>"><%= i.status %></span>
          </td>
          <td class="tiny muted"><%= formatDateTime(i.created_at) %></td>
          <td>
            <% if (i.status === 'new') { %>
              <form method="post" action="/admin/zapytania/<%= i.id %>/status">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-dark" name="status" value="handled">Załatwione</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
      <% if (!inquiries.length) { %><tr><td colspan="6" class="muted">Brak zapytań.</td></tr><% } %>
    </tbody>
  </table>
</div>
