name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm run build
      - run: npm test
        env:
          NODE_ENV: test
          SESSION_SECRET: ci-test-secret-0000000000000000000000000000

  # Opcjonalny deploy przez SSH — odkomentuj i ustaw sekrety w repo:
