# ============================================================================
#  Nowy Browar Gdański — konfiguracja aplikacji (PROTOTYP)
#  Skopiuj do `.env` i uzupełnij. `.env` NIGDY nie trafia do repo.
# ============================================================================

# --- Podstawy ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Publiczny adres bazowy (bez końcowego /). Używany w kanonicznych URL, OG, sitemap.
BASE_URL=http://localhost:3000

# Sekret do podpisywania sesji i tokenów CSRF (wygeneruj: openssl rand -hex 32)
SESSION_SECRET=zmień-mnie-na-losowy-ciag-64-znakow
COOKIE_SECURE=false

# --- Autoryzacja -----------------------------------------------------------
# mock  = ekran "zaloguj jako" bez Google (do prezentacji prototypu)
# google = prawdziwy OAuth Google (wymaga CLIENT_ID/SECRET poniżej)
AUTH_MODE=mock

# Główny administrator — twardo wpisany adres Gmail (wg wymagań klienta).
# Można podać kilka adresów po przecinku.
ADMIN_EMAILS=karol.konop@gmail.com

# Google OAuth 2.0 (tylko gdy AUTH_MODE=google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Płatności (MOCK) -----------------------------------------------------
# mock = symulowana bramka z przyciskami "Zapłać / Odrzuć"
# docelowo: autopay | przelewy24 | payu | stripe
PAYMENTS_PROVIDER=mock
PAYMENTS_CURRENCY=PLN

# --- Poczta (MOCK) ------------------------------------------------------
# outbox = wiadomości zapisywane jako pliki .eml w data/outbox + widok w adminie
# docelowo: smtp | resend | brevo
MAILER=outbox
MAIL_FROM="Nowy Browar Gdański <no-reply@nowybrowargdanski.pl>"
MAIL_TO_CONTACT=kontakt@nowybrowargdanski.pl
MAIL_TO_B2B=handel@nowybrowargdanski.pl
MAIL_TO_SHOP=sklep@nowybrowargdanski.pl

# --- Analityka / integracje (puste = wyłączone, aplikacja działa bez nich) --
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
CLARITY_PROJECT_ID=

# --- Dane firmy (NAP) — nadpisują wartości domyślne z kodu -----------------
BUSINESS_NAME=Nowy Browar Gdański
BUSINESS_STREET=ul. Jana Kilińskiego 7E
BUSINESS_POSTAL=80-452
BUSINESS_CITY=Gdańsk
BUSINESS_PHONE=+48 731 707 177
BUSINESS_LAT=54.38228
BUSINESS_LNG=18.60130

# --- Limity / bezpieczeństwo ---------------------------------------------
UPLOAD_MAX_MB=25
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
